# App
ENV=development
DEBUG=true
SETUP_TOKEN=change-me-to-a-secure-setup-token

# Banco de dados
DATABASE_URL=postgresql+asyncpg://finapp:finapp@localhost:5432/finapp

# Autenticação
JWT_SECRET=change-me-to-a-random-256-bit-value
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Pluggy
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_BASE_URL=https://api.pluggy.ai
PLUGGY_WEBHOOK_SECRET=change-me

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5000

# Observabilidade
SENTRY_DSN=
LOG_LEVEL=INFO
